## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/
_ReSharper*/
*.resharper
[Tt]est[Rr]esult*
*.bak
*.orig

# Visual Studio Code
.vscode/

# Rider
.idea/

# Build results of .NET Core
*.dll
*.pdb
*.exe

# Visual Studio Code
*.sln.iml

# SQL Server files
*.mdf
*.ldf
*.ndf

# Windows image file caches
Thumbs.db
ehthumbs.db
Desktop.ini

# Other files
*.log
*.tmp
*.temp
*.cache

# ============================================
# .NET Core / .NET 6/7/8
# ============================================

# Project files
*.csproj.user
*.suo
*.userosscache

# NuGet packages
*.nupkg
*.snupkg

# NuGet package manager
packages/
*.nupkg.metadata
*.nuget.props

# .NET Core build artifacts
project.lock.json
project.assets.json

# .NET Core publish
/publish/

# ============================================
# Entity Framework / EF Core
# ============================================

# Migrations (opcional - descomente se quiser ignorar)
# **/Migrations/*.Designer.cs
# **/Migrations/*.cs

# ============================================
# Azure / Cloud
# ============================================

# Azure Functions
bin/
obj/
local.settings.json

# ============================================
# User-specific files
# ============================================

*.dbmdl
*.dbproj.schemaview
*.jfm
*.pidb
*.publishsettings
*.vsp
*.vspx

# ============================================
# Coverage files
# ============================================

*.coverage
*.coveragexml
*.coveragejson
*.dotCover

# ============================================
# Diagnostic files
# ============================================

*.hprof
*.gcda
*.gcno
*.trace

# ============================================
# Environment Variables
# ============================================

.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ============================================
# Database
# ============================================

*.sqlite
*.sqlite3
*.db
*.db3

# ============================================
# Sensitive data (NUNCA COMMITE!)
# ============================================

# Arquivos de configuração com senhas
**/appsettings.Production.json
**/appsettings.Development.json
**/secrets.json

# Não commite o appsettings.json se tiver credenciais reais!
# appsettings.json (descomente se quiser ignorar)
